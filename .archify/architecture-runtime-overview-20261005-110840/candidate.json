  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Runtime Path: Visual Search & Order",
      "items": [
        "1. Customer sends saree screenshot from Instagram or Pinterest via WhatsApp",
        "2. Meta Cloud API delivers webhook payload with HMAC-SHA256 signature verification",
        "3. Gemini 2.5 Flash analyzes fabric, weave style, motifs, border, and price estimate",
        "4. Gemini embedding-2 model encodes visual attributes into 768-dimensional vector",
        "5. Supabase pgvector performs cosine distance match against saree_catalog (match_sarees RPC)",
        "6. WhatsApp sends interactive carousel cards; customer confirms order number (e.g. SAI-1001)",
        "7. Autonomous Tally Agent syncs order and commits XML Sales Voucher to TallyPrime ERP"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inventory & ERP Synchronization",
      "items": [
        "Local Node.js daemon polls Supabase orders table on a 3-second cycle",
        "Constructs Tally XML envelope targeting Stock Summary & Sales Vouchers on port 9000",
        "Immediate inventory deduction in TallyPrime prevents overselling high-demand sarees",
        "Bidirectional reconciliation: changes in Tally stock balance automatically reflect in bot"
      ]
    },
    {
      "dot": "violet",
      "title": "Store Operations & Administration",
      "items": [
        "Local Express dashboard (:3000) provides real-time latency and sync health metrics",
        "Catalog management allows store staff to upload missing photos and edit prices",
        "Direct multipart upload to Supabase Storage public bucket saree-catalog-images",
        "Background batch embedding scripts regenerate vectors on catalog updates"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Security Architecture",
      "items": [
        "Public Webhook perimeter protected by Meta X-Hub-Signature-256 HMAC verification",
        "Supabase Edge Functions operate with strict Service Role JWT token authorization",
        "Private Store LAN perimeter isolates TallyPrime ERP HTTP server from internet exposure",
        "Customer session state and conversational memories isolated per customer phone number"
      ]
    }
  ]
