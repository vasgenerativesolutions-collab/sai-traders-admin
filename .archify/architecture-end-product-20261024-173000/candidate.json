  "cards": [
    {
      "dot": "emerald",
      "title": "Main Admin & Cloudflare Media Distribution",
      "items": [
        "Sai Traders Main Admin manages master product catalog, pricing, and high-definition video reels",
        "Media assets are hosted in Cloudflare R2 with zero-egress cost and globally accelerated edge delivery",
        "Public CDN media links automatically populate MongoDB without changing web database schemas",
        "Central inventory authority guarantees stock levels remain synchronized across all channels"
      ]
    },
    {
      "dot": "cyan",
      "title": "Unmodified External Storefront Integration",
      "items": [
        "External Angular and Express applications operate as an independent subsystem with zero code modifications",
        "Product browsing, cart management, and Razorpay payment capture proceed exactly as originally implemented",
        "Only 1 Webhook Touchpoint required: Express server forwards paid orders to Sai Traders Ingress Webhook",
        "No requirement for external team to install Tally bridges, WhatsApp SDKs, or local connectors"
      ]
    },
    {
      "dot": "rose",
      "title": "Distributed Seat-Booking Concurrency Engine",
      "items": [
        "Implements a BookMyShow-style 10-minute hold reservation across both digital channels",
        "WhatsApp hold requests instantly mirror into MongoDB reservedStock, preventing web buyers from purchasing held units",
        "Web checkouts lock inventory locally; captured Razorpay payments trigger downstream final deductions",
        "Expired or abandoned checkouts automatically release held quantities back to public availability"
      ]
    },
    {
      "dot": "violet",
      "title": "Autonomous Tally ERP & Physical Fulfillment",
      "items": [
        "Verified orders are automatically enqueued with idempotent protection to the transactional agent jobs queue",
        "Local shop daemon securely polls via outbound HTTPS and synchronizes sales vouchers into TallyPrime :9000",
        "Customer ledgers automatically mapped to Sundry Debtors with compliant GST invoicing under Online Godown",
        "Tumakuru store fulfillment prints pick-lists, packs sarees, and generates customer courier tracking updates"
      ]
    }
  ]
