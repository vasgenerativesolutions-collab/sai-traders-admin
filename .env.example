# ==============================================================================
# Sai Traders — WhatsApp Saree Intelligence Bot Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Credentials
# ------------------------------------------------------------------------------
# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (NEVER expose to client; used by Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Supabase Anon Public Key (for frontend / public access if needed)
SUPABASE_ANON_KEY=eyJh...

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
# Permanent System User Access Token from Meta Business Manager
WHATSAPP_ACCESS_TOKEN=EAAG...

# Phone Number ID from WhatsApp App Dashboard -> API Setup
WHATSAPP_PHONE_NUMBER_ID=109876543210987

# App Secret from Meta App Dashboard -> Basic Settings (for HMAC verification)
WHATSAPP_APP_SECRET=a1b2c3d4e5f6...

# Custom verify token for Webhook handshake (any random secret string you choose)
WHATSAPP_VERIFY_TOKEN=sai_traders_webhook_secret_2026

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Credentials
# ------------------------------------------------------------------------------
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Optional: Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Optional Payment Credentials (Phase 2)
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 Storage (Media CDN - 10 GB Free Tier)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_BUCKET=saitraders-media
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# ------------------------------------------------------------------------------
# 6. External Storefront Webhook & Staging
# ------------------------------------------------------------------------------
STOREFRONT_API_KEY=your-storefront-api-key
SAI_STOREFRONT_WEBHOOK_SECRET=your-hmac-sha256-secret

# ------------------------------------------------------------------------------
# 7. Store PC High-Availability & Named Tunnel (Optional Production Setup)
# ------------------------------------------------------------------------------
# Leave blank to use automated quick tunnel (trycloudflare.com)
# Set these if you have configured a persistent named tunnel in Cloudflare Zero Trust:
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
# CLOUDFLARE_TUNNEL_DOMAIN=https://store-gateway.yourdomain.com


# MCP server auth (not used by the app; needed by .vscode/mcp.json)
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Deployment mode: "local" on a Store PC (loopback admin allowed), "hosted" for the
# KalpaCodes-hosted dashboard (every request must authenticate).
DEPLOYMENT_MODE=local

# Extra browser origins allowed to call this API (comma-separated).
# Needed when the dashboard is served from somewhere other than this server.
STOREFRONT_ORIGINS=https://vasgenerativesolutions-collab.github.io


# Tally naming. Defaults work on any fresh company: every TallyPrime company has
# a Primary stock group and a Main Location godown. Override per shop if needed.
TALLY_STOCK_GROUP=Primary
TALLY_DEFAULT_GODOWN=Main Location